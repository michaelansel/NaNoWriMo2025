{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nanoif.invalid/schemas/artifacts/story_bible.schema.json",
  "title": "Story Bible",
  "description": "dist/story-bible.json: the assembled Story Bible v2 (ADR-020), rendered from ai/story-bible-cache.json and story-overrides.txt with no model.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta", "cache_present", "passage_count", "cast", "places", "items", "groups",
    "world_rules", "conflicts", "intentional_mysteries", "unmatched_overrides", "freshness"
  ],
  "definitions": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claim", "quote", "passage", "kind", "pinned", "quote_found", "evidence", "restatements"],
      "properties": {
        "entity": { "type": "string" },
        "id": { "type": "string", "minLength": 1 },
        "claim": { "type": "string" },
        "quote": { "type": "string" },
        "passage": { "type": "string" },
        "kind": { "enum": ["trait", "relationship", "location", "possession", "event", "rule"] },
        "pinned": { "type": "boolean" },
        "quote_found": { "type": "boolean" },
        "evidence": { "type": "integer", "minimum": 1 },
        "restatements": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "type", "aliases", "role", "passages", "facts", "rules", "pending"],
      "properties": {
        "slug": { "type": "string" },
        "name": { "type": "string" },
        "type": { "enum": ["character", "location", "item", "group", "world"] },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "role": { "type": ["string", "null"] },
        "passages": { "type": "array", "items": { "type": "string" } },
        "facts": { "type": "array", "items": { "$ref": "#/definitions/fact" } },
        "rules": { "type": "array", "items": { "$ref": "#/definitions/fact" } },
        "pending": { "type": "boolean" }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity", "note", "facts", "intentional"],
      "properties": {
        "id": { "type": "string" },
        "entity": { "type": "string" },
        "note": { "type": "string" },
        "facts": { "type": "array", "items": { "$ref": "#/definitions/fact" }, "minItems": 2, "maxItems": 2 },
        "intentional": { "type": ["string", "null"] }
      }
    },
    "names": { "type": "array", "items": { "type": "string" } }
  },
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated", "commit", "schema_version"],
      "properties": {
        "generated": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "schema_version": { "const": "2.0.0" }
      }
    },
    "cache_present": { "type": "boolean" },
    "passage_count": { "type": "integer", "minimum": 0 },
    "cast": { "type": "array", "items": { "$ref": "#/definitions/entity" } },
    "places": { "type": "array", "items": { "$ref": "#/definitions/entity" } },
    "items": { "type": "array", "items": { "$ref": "#/definitions/entity" } },
    "groups": { "type": "array", "items": { "$ref": "#/definitions/entity" } },
    "world_rules": { "type": "array", "items": { "$ref": "#/definitions/fact" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/definitions/conflict" } },
    "intentional_mysteries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "line", "conflicts"],
        "properties": {
          "label": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "conflicts": { "type": "array", "items": { "$ref": "#/definitions/conflict" } }
        }
      }
    },
    "unmatched_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line", "text"],
        "properties": {
          "line": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "extracted_at", "mode", "extraction_result", "changed", "new", "deleted", "pending"],
      "properties": {
        "commit": { "type": ["string", "null"] },
        "extracted_at": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] },
        "extraction_result": { "enum": ["success", "failure", "cancelled", "skipped"] },
        "changed": { "$ref": "#/definitions/names" },
        "new": { "$ref": "#/definitions/names" },
        "deleted": { "$ref": "#/definitions/names" },
        "pending": { "$ref": "#/definitions/names" }
      }
    }
  }
}
